{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@earendil-works/pi-ai": ["./node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-ai"],
      "@earendil-works/pi-tui": ["./node_modules/@earendil-works/pi-tui"]
    }
  },
  "include": ["extensions/**/*.ts", "lib/**/*.ts"]
}
